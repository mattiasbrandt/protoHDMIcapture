# protoHDMIcapture settings. Copy to ~/.config/protohdmicapture/config.
# One KEY=value per line; the file is parsed, not executed. Environment
# variables win over this file, so `DELAY=0.1 ./view.sh` still works.

# Pin the card by USB serial so other cameras and /dev/video renumbering never
# matter. ./view.sh --setup finds it and writes this line.
#CARD_SERIAL=

# A card that reports no serial (the MS2109) is pinned by its USB port
# instead (udev ID_PATH); it is found again after a replug into the same port.
# Setting CARD_SERIAL, CARD_PORT or DEV in the environment overrides all three
# here, e.g. `CARD_PORT=pci-0000:16:00.4-usb-0:2:1.0 ./view.sh` for one run.
#CARD_PORT=

# Without a pin: card types (v4l2 "Card type", extended regex) to skip
# while scanning for the card.
#IGNORE_CARDS_RE='OBSBOT|Integrated Camera'

# Audio delay in seconds that lines audio up with video (tune with --tune).
#DELAY=0.05

# Display mode: fullscreen | borderless (maximized, no decorations) | windowed
#WINDOW=fullscreen
#WINDOW_SIZE=1280x720

# Troubleshooting: off | log | window (log plus a live dashboard)
#DEBUG=off

# Any other view.sh knob works here too: DEV SRC SINK RES FPS FMT LAT_MS
# BACKEND AUDIO SCALING LEVELS IPC REFRESH GST_IO_MODE
