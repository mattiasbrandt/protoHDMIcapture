#!/usr/bin/env bash
# A worker's worktree for one ticket of an epic (.claude/skills/coordinate-epic):
# a local branch off main, checked out under .claude/worktrees/, with the
# viewer's cargo target copied in by reflink so the worker's first build reuses
# the dependencies instead of compiling them again.
# Usage: tools/epic-worktree <issue> <slug>     e.g. tools/epic-worktree 21 telemetry
# Prints the worktree's path. Nothing is pushed: the branch stays local, and
# the coordinator integrates it onto main by rebase.
set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1

die() { printf 'epic-worktree: %s\n' "$1" >&2; exit 1; }

[ $# -eq 2 ] || die "usage: tools/epic-worktree <issue> <slug>"
issue=$1 slug=$2
[[ $issue =~ ^[0-9]+$ ]] || die "issue must be a number, not '$issue'"
[[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug must be lowercase letters, digits and dashes, not '$slug'"

name="$issue-$slug"
path=".claude/worktrees/$name"
git check-ignore -q "$path" || die "$path is not ignored by git; add .claude/worktrees/ to .gitignore"
git show-ref --verify --quiet "refs/heads/$name" && die "branch $name exists already (git worktree list)"
[ -e "$path" ] && die "$path exists already"

git worktree add -q "$path" -b "$name" main || die "git worktree add failed"

# A plain copy where the filesystem has no reflinks: slower, same result.
if [ -d viewer/target ]; then
    if ! cp -a --reflink=auto viewer/target "$path/viewer/target"; then
        printf 'epic-worktree: warning: viewer/target not copied; the first build compiles every dependency\n' >&2
    fi
fi

printf '%s\n' "$(readlink -f "$path")"
