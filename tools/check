#!/usr/bin/env bash
# Static checks for protoHDMIcapture; the pre-commit hook runs this.
# Usage: tools/check
set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1

fail=0
step() { printf '\033[36m:: %s\033[0m\n' "$1"; }
bad()  { printf '\033[31m!! %s\033[0m\n' "$1"; fail=1; }

mapfile -t SH < <(git ls-files '*.sh' view.sh launch.sh tools/check tools/capture-cards-table .githooks/pre-commit | sort -u)
mapfile -t LUA < <(git ls-files '*.lua')
mapfile -t PY < <(git ls-files '*.py')

step "shellcheck (${#SH[@]} files)"
shellcheck -x -S warning "${SH[@]}" || bad "shellcheck"

step "lua syntax (${#LUA[@]} files)"
for f in "${LUA[@]}"; do luac -p "$f" || bad "luac: $f"; done

step "python syntax (${#PY[@]} files)"
for f in "${PY[@]}"; do python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f" || bad "python: $f"; done

# read splits on IFS whitespace, and a tab is whitespace: two tabs around an
# empty field collapse into one and every later field shifts. Use a
# non-whitespace separator such as "|".
step "no tab-separated read"
if grep -nE "IFS=\\\$'\\\\t'[[:space:]]+read" "${SH[@]}"; then
    bad "IFS=\$'\\t' read collapses empty fields; use a non-whitespace separator"
fi

# Each fixture: a config file, optional KEY=value lines for the environment,
# and the expected exit status plus regexes that some output line must match.
# Run with a bare environment so the caller's own settings cannot leak in.
mapfile -t FIX < <(ls tools/fixtures/settings/*.config 2>/dev/null)
step "settings fixtures (${#FIX[@]})"
for cfg in "${FIX[@]}"; do
    base="${cfg%.config}"; name="${base##*/}"
    envs=(); [ -r "$base.env" ] && mapfile -t envs <"$base.env"
    out=$(env -i HOME="$HOME" PATH="$PATH" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}" \
          CONFIG_FILE="$cfg" "${envs[@]}" ./view.sh --settings 2>&1)
    rc=$?
    want=$(sed -n '1s/^exit //p' "$base.expect")
    [ "$rc" = "$want" ] || bad "settings fixture $name: exit $rc, expected $want"
    while IFS= read -r re; do
        grep -Eq -- "$re" <<<"$out" || bad "settings fixture $name: no line matches /$re/"
    done < <(tail -n +2 "$base.expect")
done

# The Rust viewer (viewer/, #10): build, tests and clippy; then every settings
# fixture through both viewers, which must print the same and exit the same,
# since they share the settings file.
step "viewer: cargo build, test, clippy"
if ! command -v cargo >/dev/null; then
    bad "cargo not found: the Rust viewer (viewer/) needs a Rust toolchain (rustup)"
else
    cargo build --manifest-path viewer/Cargo.toml --quiet || bad "viewer: cargo build"
    cargo test --manifest-path viewer/Cargo.toml --quiet >/dev/null || bad "viewer: cargo test (rerun it to see which)"
    cargo clippy --manifest-path viewer/Cargo.toml --all-targets --quiet -- -D warnings || bad "viewer: cargo clippy"
    step "settings fixtures: view.sh and the Rust viewer agree (${#FIX[@]})"
    for cfg in "${FIX[@]}"; do
        base="${cfg%.config}"; name="${base##*/}"
        envs=(); [ -r "$base.env" ] && mapfile -t envs <"$base.env"
        sh_out=$(env -i HOME="$HOME" PATH="$PATH" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}" \
                 CONFIG_FILE="$cfg" "${envs[@]}" ./view.sh --settings 2>&1; echo "exit $?")
        rs_out=$(env -i HOME="$HOME" PATH="$PATH" \
                 CONFIG_FILE="$cfg" "${envs[@]}" viewer/target/debug/protohdmicapture --settings 2>&1; echo "exit $?")
        [ "$sh_out" = "$rs_out" ] || { bad "settings fixture $name: the viewers differ"; diff <(echo "$sh_out") <(echo "$rs_out") | head -10; }
    done
    # The Windows build (#18): clippy only, no link, so no Windows SDK is
    # needed; skipped where the target is not installed.
    win=x86_64-pc-windows-msvc
    if rustup target list --installed 2>/dev/null | grep -qx "$win"; then
        step "viewer: clippy for Windows ($win)"
        cargo clippy --manifest-path viewer/Cargo.toml --target "$win" --quiet -- -D warnings || bad "viewer: clippy for Windows"
    else
        step "viewer: clippy for Windows skipped (rustup target add $win)"
    fi
fi

# A source profile may suggest only the settings flagged "suggest".
step "source profile suggestions"
mapfile -t SUGGESTABLE < <(bash -c '. lib/settings.sh; settings_with suggest')
for f in sources/*.md; do
    for kv in $(sed -n 's/^Suggest:[[:space:]]*//p' "$f"); do
        [[ " ${SUGGESTABLE[*]} " == *" ${kv%%=*} "* ]] \
            || bad "$f suggests ${kv%%=*}, which is not a suggestable setting (${SUGGESTABLE[*]})"
    done
done

# Every setting has a row in README's settings table (first cell) and is named
# in config.example; the table names nothing that is not a setting.
step "settings documented"
mapfile -t ALL_SETTINGS < <(bash -c '. lib/settings.sh; settings_with')
documented=$(sed -n '/^### The settings worth knowing/,/^#/p' README.md | grep '^| `' \
             | cut -d'|' -f2 | grep -oE '`[A-Z_]+`' | tr -d '`' | sort -u)
for n in "${ALL_SETTINGS[@]}"; do
    grep -qx "$n" <<<"$documented" || bad "README: setting $n has no row in \"The settings worth knowing\""
    grep -qE "(^|[^A-Z_])$n([^A-Z_]|$)" config.example || bad "config.example: setting $n is not mentioned"
done
for d in $documented; do
    [[ " ${ALL_SETTINGS[*]} " == *" $d "* ]] || bad "README: $d has a settings row but is not a setting (lib/settings.sh)"
done

# Hardware-free checks of the functions behind past defects (each names the
# commits it guards); a harness prints what failed and exits non-zero.
HARN=()
for h in tools/harness/*.sh; do [ "${h##*/}" = lib.sh ] || HARN+=("$h"); done
step "harnesses (${#HARN[@]})"
for h in "${HARN[@]}"; do
    timeout -k 2 30 "$h" || bad "harness ${h##*/} failed"
done

step "capture card table up to date"
tools/capture-cards-table --check || bad "docs/capture-cards.md is stale"

[ "$fail" = 0 ] && printf '\033[32m✓ all checks pass\033[0m\n'
exit "$fail"
