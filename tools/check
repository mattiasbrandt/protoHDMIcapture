#!/usr/bin/env bash
# Static checks for protoHDMIcapture; the pre-commit hook runs this.
# Usage: tools/check
set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
# A heavy job: queued behind any other, at the lowest priority (tools/heavy).
[ -n "${PROTOHDMI_HEAVY_LOCKED:-}" ] || exec tools/heavy tools/check "$@"

fail=0
# The names in settings.rows carrying flag $1 (every name without one), in
# its order, as legacy's settings_with lists them.
rows_with() {
    awk -F'|' -v flag="${1:-}" '
        { line = $0; gsub(/ /, "", line) }
        line == "" || substr($0, 1, 1) == "#" { next }
        { name = $1; flags = $5; gsub(/ /, "", name); gsub(/ /, "", flags)
          if (flag == "" || index("," flags ",", "," flag ",")) print name }' settings.rows
}
step() { printf '\033[36m:: %s\033[0m\n' "$1"; }
bad()  { printf '\033[31m!! %s\033[0m\n' "$1"; fail=1; }

mapfile -t SH < <(git ls-files '*.sh' tools/check tools/capture-cards-table tools/epic-worktree tools/heavy tools/process-globals tools/commit-subject .githooks/pre-commit .githooks/commit-msg | sort -u)
mapfile -t LUA < <(git ls-files '*.lua')
mapfile -t PY < <(git ls-files '*.py')

step "shellcheck (${#SH[@]} files)"
shellcheck -x -S warning "${SH[@]}" || bad "shellcheck"

step "lua syntax (${#LUA[@]} files)"
for f in "${LUA[@]}"; do luac -p "$f" || bad "luac: $f"; done

step "python syntax (${#PY[@]} files)"
for f in "${PY[@]}"; do python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f" || bad "python: $f"; done

# read splits on IFS whitespace, and a tab is whitespace: two tabs around an
# empty field collapse into one and every later field shifts. Use a
# non-whitespace separator such as "|".
step "no tab-separated read"
if grep -nE "IFS=\\\$'\\\\t'[[:space:]]+read" "${SH[@]}"; then
    bad "IFS=\$'\\t' read collapses empty fields; use a non-whitespace separator"
fi

# protoHDMIcapture (the crate at the root): formatting, build, tests and clippy; then every settings
# fixture through its --settings.
mapfile -t FIX < <(ls tools/fixtures/settings/*.config 2>/dev/null)
step "protoHDMIcapture: cargo fmt, build, test, clippy"
if ! command -v cargo >/dev/null; then
    bad "cargo not found: protoHDMIcapture needs a Rust toolchain (rustup)"
else
    cargo fmt --check >/dev/null || bad "protoHDMIcapture: not formatted (cargo fmt; rustfmt.toml holds the style)"
    cargo build --quiet || bad "protoHDMIcapture: cargo build"
    # The output is kept until the end: a test that fails once (a flake)
    # must name itself here, as a rerun may pass.
    test_log=$(mktemp)
    if ! cargo test --quiet >"$test_log" 2>&1; then
        grep -E '^test .* FAILED$|panicked at|^error' "$test_log"
        bad "protoHDMIcapture: cargo test"
    fi
    rm -f "$test_log"
    cargo clippy --all-targets --quiet -- -D warnings || bad "protoHDMIcapture: cargo clippy"
    # Each fixture: a config file, optional KEY=value lines for the
    # environment, and the expected exit status plus regexes that some output
    # line must match. Run with a bare environment so the caller's own
    # settings cannot leak in.
    step "settings fixtures (${#FIX[@]})"
    for cfg in "${FIX[@]}"; do
        base="${cfg%.config}"; name="${base##*/}"
        envs=(); [ -r "$base.env" ] && mapfile -t envs <"$base.env"
        out=$(env -i HOME="$HOME" PATH="$PATH" \
              CONFIG_FILE="$cfg" "${envs[@]}" "${CARGO_TARGET_DIR:-target}/debug/protohdmicapture" --settings 2>&1)
        rc=$?
        want=$(sed -n '1s/^exit //p' "$base.expect")
        [ "$rc" = "$want" ] || bad "settings fixture $name: exit $rc, expected $want"
        while IFS= read -r re; do
            grep -Eq -- "$re" <<<"$out" || bad "settings fixture $name: no line matches /$re/"
        done < <(tail -n +2 "$base.expect")
    done
    # The Windows build (#18): clippy only, no link, so no Windows SDK is
    # needed; skipped where the target is not installed.
    win=x86_64-pc-windows-msvc
    if rustup target list --installed 2>/dev/null | grep -qx "$win"; then
        step "protoHDMIcapture: clippy for Windows ($win)"
        cargo clippy --target "$win" --quiet -- -D warnings || bad "protoHDMIcapture: clippy for Windows"
    else
        step "protoHDMIcapture: clippy for Windows skipped (rustup target add $win)"
    fi
    # The dev feature (#64: the clip recorder and replay) in its own target
    # dir, so the default build above, which the fixtures run, is never
    # replaced by a dev binary.
    step "protoHDMIcapture --features dev: build, test, clippy"
    dev_target="${CARGO_TARGET_DIR:-target}/dev"
    cargo build --features dev --target-dir "$dev_target" --quiet || bad "protoHDMIcapture --features dev: cargo build"
    dev_log=$(mktemp)
    if ! cargo test --features dev --target-dir "$dev_target" --quiet >"$dev_log" 2>&1; then
        grep -E '^test .* FAILED$|panicked at|^error' "$dev_log"
        bad "protoHDMIcapture --features dev: cargo test"
    fi
    rm -f "$dev_log"
    cargo clippy --features dev --target-dir "$dev_target" --all-targets --quiet -- -D warnings || bad "protoHDMIcapture --features dev: cargo clippy"
fi

# State shared by every window run in the process carries its reason (#25):
# the dashboard's numbers were one global that the wizard's windows wrote
# into (#21).
# Temporary measurements (MEASURE lines on stderr, env overrides for an
# A/B) are taken out before a commit; a launcher built from the tree
# would print them.
step "no temporary measurements"
if git grep -n 'eprintln!("MEASURE' -- src; then
    bad "a temporary MEASURE line is left in src/"
fi

# A path a comment or doc names must exist: a renamed or deleted file
# leaves its old path behind (src/desktop.rs named a harness that never was).
# Untracked files count, so a new doc is checked before it is staged.
step "named repo paths exist"
git grep --untracked -ohE '(^|[^/[:alnum:]_.-])(tools|legacy|docs|vendor|capture-cards|sources|\.github)/[[:alnum:]_./-]+\.(sh|rs|md|py|lua|yml|patch|rows)' -- src docs '*.md' tools \
    | sed -E 's|^[^/[:alnum:]_.-]||' | sort -u | while read -r p; do
    [ -e "$p" ] || echo "$p"
done | grep . && bad "a named path does not exist"

step "no unmarked process-global state"
tools/process-globals || bad "process-global state without \`// process-global: <reason>\`"

# A source profile may suggest only the settings flagged "suggest".
step "source profile suggestions"
mapfile -t SUGGESTABLE < <(rows_with suggest)
for f in sources/*.md; do
    for kv in $(sed -n 's/^Suggest:[[:space:]]*//p' "$f"); do
        [[ " ${SUGGESTABLE[*]} " == *" ${kv%%=*} "* ]] \
            || bad "$f suggests ${kv%%=*}, which is not a suggestable setting (${SUGGESTABLE[*]})"
    done
done

# Every setting has a row in README's settings table (first cell) and is named
# in config.example; the table names nothing that is not a setting.
step "settings documented"
mapfile -t ALL_SETTINGS < <(rows_with)
documented=$(sed -n '/^### The settings worth knowing/,/^#/p' README.md | grep '^| `' \
             | cut -d'|' -f2 | grep -oE '`[A-Z_]+`' | tr -d '`' | sort -u)
for n in "${ALL_SETTINGS[@]}"; do
    grep -qx "$n" <<<"$documented" || bad "README: setting $n has no row in \"The settings worth knowing\""
    grep -qE "(^|[^A-Z_])$n([^A-Z_]|$)" config.example || bad "config.example: setting $n is not mentioned"
done
for d in $documented; do
    [[ " ${ALL_SETTINGS[*]} " == *" $d "* ]] || bad "README: $d has a settings row but is not a setting (settings.rows)"
done

# Hardware-free checks of the functions behind past defects (each names the
# commits it guards); a harness prints what failed and exits non-zero.
HARN=()
for h in tools/harness/*.sh; do [ "${h##*/}" = lib.sh ] || HARN+=("$h"); done
step "harnesses (${#HARN[@]})"
for h in "${HARN[@]}"; do
    timeout -k 2 30 "$h" || bad "harness ${h##*/} failed"
done

step "capture card table up to date"
tools/capture-cards-table --check || bad "docs/capture-cards.md is stale"

[ "$fail" = 0 ] && printf '\033[32m✓ all checks pass\033[0m\n'
exit "$fail"
